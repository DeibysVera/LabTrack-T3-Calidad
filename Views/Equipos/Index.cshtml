@model List<Equipo>
@{ViewData["Title"]="Catálogo de equipos";}
<section class="panel"><form method="get"><label for="categoria">Filtrar por categoría</label><select id="categoria" name="categoria"><option value="">Todas</option>@foreach(var c in new[]{"Cómputo","Electrónica","Redes"}){if(ViewBag.Categoria==c){<option selected value="@c">@c</option>}else{<option value="@c">@c</option>}}</select><button>Filtrar</button></form></section>
<section class="panel">@if(Model.Count==0){<p>No hay equipos disponibles en esta categoría</p>}else{<table><thead><tr><th>Equipo</th><th>Código</th><th>Categoría</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.Nombre</td><td>@e.CodigoInventario</td><td>@e.Categoria</td><td><span class="tag">@e.Estado</span></td><td>@if(User.IsInRole("Estudiante")){<a class="btn" asp-controller="Reservas" asp-action="Crear" asp-route-equipoId="@e.Id">Reservar</a>}</td></tr>}</tbody></table>}</section>
