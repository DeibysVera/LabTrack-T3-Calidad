<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>LabTrack</title><link rel="stylesheet" href="~/css/labtrack.css" asp-append-version="true"/></head><body><header><a class="brand" asp-controller="Home" asp-action="Index">▣ LabTrack</a><nav>@if(User.Identity?.IsAuthenticated==true){<a asp-controller="Equipos" asp-action="Index">Equipos</a>@if(User.IsInRole("Estudiante")){<a asp-controller="Reservas" asp-action="Index">Mis reservas</a>}@if(User.IsInRole("Administrador")){<a asp-controller="Admin" asp-action="Index">Administración</a>}<span>@User.Identity.Name</span><form asp-controller="Cuenta" asp-action="Salir" method="post"><button class="link" type="submit">Salir</button></form>}else{<a asp-controller="Cuenta" asp-action="Login">Ingresar</a>}</nav></header><main><h1>@ViewData["Title"]</h1>@if(TempData["Ok"]!=null){<div class="ok">@TempData["Ok"]</div>}@if(TempData["Error"]!=null){<div class="error">@TempData["Error"]</div>}@RenderBody()</main><footer>LabTrack · Calidad y Pruebas de Software · Proyecto académico</footer>@await RenderSectionAsync("Scripts",required:false)</body></html>
