@{ViewData["Title"]="Panel del administrador";var pendientes=(List<Reserva>)ViewBag.Pendientes;var activas=(List<Reserva>)ViewBag.Activas;}
<section class="panel"><h2>Solicitudes pendientes</h2><table><thead><tr><th>Estudiante</th><th>Equipo</th><th>Horario</th><th>Acciones</th></tr></thead><tbody>@foreach(var r in pendientes){<tr><td>@r.Usuario.Nombre</td><td>@r.Equipo.Nombre</td><td>@r.FechaInicio.ToString("dd/MM/yyyy HH:mm") – @r.FechaFin.ToString("dd/MM/yyyy HH:mm")</td><td><form method="post" asp-action="Aprobar"><input type="hidden" name="id" value="@r.Id"/><button>Aprobar</button></form><form method="post" asp-action="Rechazar"><input type="hidden" name="id" value="@r.Id"/><input name="motivo" required maxlength="300" placeholder="Motivo obligatorio"/><button class="danger">Rechazar</button></form></td></tr>}</tbody></table></section>
<section class="panel"><h2>Reservas aprobadas / devoluciones</h2><table><thead><tr><th>Estudiante</th><th>Equipo</th><th>Fin</th><th>Acción</th></tr></thead><tbody>@foreach(var r in activas){<tr><td>@r.Usuario.Nombre</td><td>@r.Equipo.Nombre</td><td>@r.FechaFin.ToString("dd/MM/yyyy HH:mm")</td><td><form method="post" asp-action="Devolver"><input type="hidden" name="id" value="@r.Id"/><button>Marcar devolución</button></form></td></tr>}</tbody></table></section>
